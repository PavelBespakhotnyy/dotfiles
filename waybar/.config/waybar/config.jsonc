{
	"layer": "top",
	"position": "bottom",

	"margin-top": 0,
	"margin-bottom": 0,
	"margin-left": 0,

	"spacing": 0,
	"height": 26,

	"modules-left": [
		"sway/workspaces"
	],

	"modules-right": [
		"sway/language",
		"custom/separator",
		"network",
		"custom/separator",
		"bluetooth",
		"custom/separator",
		"pulseaudio",
		"custom/separator",
		"power-profiles-daemon",
		"battery",
		"custom/separator",
		"clock",
		"tray"
	],

	"custom/separator": {
		"format": "|",
		"tooltip": false
	},

	"sway/workspaces": {
		"format": "{name}"
	},

	"tray": {
		"icon-size": 16,
		"spacing": 2
	},

	"clock": {
		"format": "{:%d.%m.%Y %H:%M:%S}",
		"interval": 5,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"format": {
				"today": "<u>{}</u>"
			}
		}
	},

	"pulseaudio": {
		"format": "Audio: {volume}",
		"format-muted": "Audio: m",
		"format-icons": {
			"default": [
				"\uf026",
				"\uf027",
				"\uf028"
			]
		},
		"on-click": "pavucontrol",
		"tooltip-format": "{volume}%"
	},

	"sway/language": {
		"format": "Language: {}",
		"format-us": "en",
		"format-en": "en",
		"format-ru": "ru"
	},

	"network": {
		"format-wifi": "Wifi: {essid}",
		"format-ethernet": "Network: Ethernet",
		"format-disconnected": "Wifi: disconnected",
		"tooltip-format-wifi": "{essid} ({signalStrength}%)",
		"on-click": "kitty --class=wifi-tui -e impala",
		"interval": 2
	},

	"bluetooth": {
		"format": "Bluetooth: {status}",
		"format-off": "Bluetooth: no devices",
		"format-disabled": "Bluetooth: disconnected",
		"tooltip-format": "{status}",
		"on-click": "kitty --class=bt-tui -e bluetui"
	},

	"battery": {
		"interval": 30,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "Battery: {capacity}%",
		"tooltip-format-discharging": "Discharging\n{capacity}% {power} w",
		"tooltip-format-charging": "Charging\n{capacity}% {power} w",
		"tooltip-format-plugged": "Plugged in\n{capacity}% {power} w",
		"tooltip-format-full": "{capacity}%",
		"format-not-charging": "",
		"tooltip-format-not-charging": "Charged\n{capacity}% {power} w",
		"format-charging": "",
		"format-plugged": "",
		"format-icons": [
			"",
			"",
			"",
			""
		]
	},

	"power-profiles-daemon": {
		"format": "Power profile: {icon}",
		"tooltip-format": "Profile: {profile}\nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"power-saver": "power-saver",
			"balanced": "balanced",
			"performance": "performance"
		}
	},

	"custom/power": {
		"format": "\uf011",
		"tooltip": false,
		"on-click": "~/.config/waybar/scripts/power.sh"
	}
}
